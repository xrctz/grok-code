{
  "name": "grok-code-playground",
  "private": true,
  "version": "0.3.1",
  "description": "Grok Code — branded VS Code shell + MCP bridge playground",
  "scripts": {
    "install:bridge": "npm install --prefix vscode-mcp/extension",
    "install:mcp": "npm install --prefix vscode-mcp/mcp-server",
    "install:all": "npm run install:bridge && npm run install:mcp && npm run build",
    "build:bridge": "npm run compile --prefix vscode-mcp/extension",
    "build:mcp": "npm run build --prefix vscode-mcp/mcp-server",
    "build": "npm run build:bridge && npm run build:mcp",
    "package:bridge": "npm run package --prefix vscode-mcp/extension",
    "package:ui": "cd vscode-mcp/grok-code-ui && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository",
    "package": "npm run package:bridge && npm run package:ui",
    "test:no-copilot": "node scripts/test-grok-code-no-copilot.mjs",
    "test:new-tools": "node scripts/test-grok-code-new-tools.mjs",
    "test:mcp": "bash vscode-mcp/scripts/smoke-test.sh",
    "test": "npm run build && npm run test:no-copilot && npm run test:new-tools && npm run test:mcp",
    "print-mcp-config": "node scripts/print-mcp-config.mjs",
    "ensure-binary": "bash scripts/ensure-vscode-binary.sh",
    "launch": "bash scripts/launch-grok-code.sh",
    "mock-bridge": "node vscode-mcp/scripts/mock-bridge.mjs"
  }
}
